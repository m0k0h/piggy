# Copia este archivo a `.env` para desarrollar en local.
# Al desplegar, estos valores salen de los secretos del repositorio en GitHub
# (Settings → Secrets and variables → Actions), no de aquí.
#
# Los dos primeros están en tu proyecto de Supabase, en Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional. Solo hace falta si un día metes más de un equipo en el mismo
# proyecto de Supabase.
# VITE_TEAM_CODE=equipo-principal
